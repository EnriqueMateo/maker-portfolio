# Copy to .env for local development. On Railway set these as service Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key: used by the server to read published projects (RLS protected)
SUPABASE_ANON_KEY=
# Service-role key: server-only, used for the contact form and `npm run seed`. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# PUBLIC_URL=https://your-domain.com   # defaults to RAILWAY_PUBLIC_DOMAIN
# CACHE_SECONDS=60                     # how long Supabase reads are cached
# SKIP_MEDIA_BUILD=1                   # skip WebP generation at build (if all media is in Supabase Storage)
